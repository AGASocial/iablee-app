# =============================================================================
# iablee-app environment placeholders — NO real secrets
# Copy to .env.local and fill in values. Do not commit .env.local.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Payment gateway selection
# Default in code is payu. Do NOT set production to wompi until keys + COP
# prices are confirmed. Supported: payu | stripe | wompi
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY=payu
NEXT_PUBLIC_PAYMENT_GATEWAY=payu

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayU WebCheckout
PAYU_ENV=sandbox
PAYU_API_KEY=
PAYU_API_LOGIN=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_PAYMENT_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu
PAYU_RESPONSE_URL=http://localhost:3000/es/payments/payu/return
PAYU_CONFIRMATION_URL=http://localhost:3000/api/webhooks/payu
PAYU_LANGUAGE=es

# Wompi (Colombia) — sandbox keys use pub_test_ / prv_test_ / test_events_ / test_integrity_
# Production events URL: https://app.iablee.com/api/webhooks/wompi
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_REDIRECT_URL=http://localhost:3000/es/payments/wompi/return
# Optional override (default https://checkout.wompi.co/p/)
# WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
